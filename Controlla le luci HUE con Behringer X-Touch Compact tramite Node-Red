    {
        "id": "fnScaleDim01",
        "type": "function",
        "z": "f1demo01midi2knx",
        "name": "Fader CC → 0–100%",
        "func": "// === CONFIG ===\n// Numero di Control Change inviato dal fader della X-Touch che vuoi usare.\n// Muovi il fader e guarda il debug \"MIDI raw\": msg.payload[0] è il CC.\n// Imposta qui il valore e fai redeploy.\nconst FADER_CC = 4;          // <-- cambia con il CC del tuo fader\n// ==============\n\n// Reagisci solo ai messaggi Control Change\nif (!msg.midi || msg.midi.type !== \"controlchange\") {\n    return null;\n}\n\nconst cc    = msg.payload[0];   // numero del controller (CC)\nconst value = msg.payload[1];   // valore 0..127\n\n// Ignora gli altri fader/encoder\nif (cc !== FADER_CC) {\n    return null;\n}\n\n// Scala MIDI 0..127  ->  KNX scaling 0..100 % (DPT 5.001)\nconst percent = Math.round((value / 127) * 100);\n\nnode.status({ fill: \"green\", shape: \"dot\", text: percent + \" %\" });\n\n\nmsg.payload=percent;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 100,
        "wires": [
            [
                "784bf7a65d95a40d"
            ]
        ]
    },

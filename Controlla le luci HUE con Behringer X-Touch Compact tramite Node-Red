    {
        "id": "8d7f5d6594400929",
        "type": "function",
        "z": "e8e18da283ed4928",
        "name": "0–100% → Fader CC",
        "func": "// === CONFIG (deve combaciare col ramo di andata) ===\nconst FADER_CC     = 4;   // STESSO CC del fader usato in andata\nconst MIDI_CHANNEL = 1;   // canale MIDI della X-Touch (Standard mode = 1)\n// ===================================================\n\nlet pct = Number(msg.payload);\nif (Number.isNaN(pct)) {\n    return null;\n}\npct = Math.max(0, Math.min(100, pct));\n\n// Scala KNX 0..100 %  ->  MIDI 0..127\nconst value = Math.round(pct / 100 * 127);\n\nnode.status({ fill: \"blue\", shape: \"dot\", text: pct + \" % → CC \" + FADER_CC + \"=\" + value });\n\n// Il nodo 'midi out' costruisce i byte da msg.midi\nmsg.midi = {\n    type: \"controlchange\",\n    channel: MIDI_CHANNEL,\n    data: [FADER_CC, value]\n};\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 100,
        "wires": [
            [
                "a9c4614d3323a7e6"
            ]
